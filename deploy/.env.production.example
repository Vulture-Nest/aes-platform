# AES production env — lives ONLY on the droplet at /opt/aes/.env (never committed).
# `compose.prod.yml` reads this via `env_file: .env`. Copy to /opt/aes/.env and fill in.

# --- Registry (so compose can interpolate the image names) ---
# Same value as the REGISTRY GitHub secret, e.g. ghcr.io/vulture-nest
REGISTRY=ghcr.io/vulture-nest
# The deploy workflow overrides IMAGE_TAG with the commit SHA; latest is the fallback.
IMAGE_TAG=latest

# --- Public hostnames (the shared Traefik edge routes these + issues TLS) ---
# AES now lives under the shared vulturenest.org root (was aes.co.zw).
# INTERIM (before DNS): swap the domain for <DROPLET_IP>.nip.io.
WEB_HOST=aes.vulturenest.org
ADMIN_HOST=admin.aes.vulturenest.org
API_HOST=api.aes.vulturenest.org

# --- Database: DO Managed Postgres (shared cluster, dedicated `aes` database) ---
# Create a database `aes` + user on your existing managed cluster, then use the
# CONNECTION POOL host if you enabled PgBouncer. Must include sslmode=require.
DATABASE_URL=postgresql://aes_app:CHANGE_ME@your-cluster-do-user.b.db.ondigitalocean.com:25060/aes?sslmode=require
# Owner/direct URL for `prisma migrate deploy` (role that owns the schema + can
# create the aes_app RLS role). Prisma uses this as directUrl.
DATABASE_URL_OWNER=postgresql://aes:CHANGE_ME@your-cluster-do-user.b.db.ondigitalocean.com:25060/aes?sslmode=require

# --- Auth ---
JWT_SECRET=CHANGE_ME_long_random_production_secret

# --- Object storage (attachments/receipts). Self-hosted MinIO or DO Spaces. ---
STORAGE_ENDPOINT=CHANGE_ME
STORAGE_PORT=443
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=aes-files

# ---------------------------------------------------------------------------
# Root environment example for local development (docker-compose.dev.yml).
# Copy to .env and adjust. NEVER commit a real .env — secrets live in a vault.
# The API reads its own apps/api/.env; this file drives docker compose.
# ---------------------------------------------------------------------------

# --- PostgreSQL 16 ---
POSTGRES_USER=aes
POSTGRES_PASSWORD=aes_local_dev
POSTGRES_DB=aes
POSTGRES_PORT=5432

# --- Redis 7 (BullMQ) ---
REDIS_PORT=6379

# --- MinIO (local stand-in for SharePoint/Graph file storage) ---
MINIO_ROOT_USER=aes-minio
MINIO_ROOT_PASSWORD=aes_minio_local_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

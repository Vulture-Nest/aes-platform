// AES platform — Prisma schema.
//
// S1 Foundations: local JWT auth (self-managed, NOT Entra/OIDC),
// self-managed RBAC (roles per user per site), append-only audit log, and sites.
// Financial-core tables (orders, ledger, tax, …) arrive in S3.
//
// Conventions (see the README "Architecture decisions"):
//   - UUID primary keys
//   - created_by / created_at / updated_by / updated_at on business tables
//   - money stored as (amount, currency, fx_rate_id, rate_type) — never a bare number

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trivial table used only to prove connectivity + migrations in the S0 scaffold.
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_check")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

// ---------------------------------------------------------------------------
// Identity — local user store (we own auth; no third-party IdP)
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  /// Optional link to an employees record (added in S8 HR-lite).
  employeeId   String?    @map("employee_id") @db.Uuid
  /// Privileged roles (FD/OD/Director/SysAdmin) must complete MFA — enforced later.
  mfaRequired  Boolean    @default(false) @map("mfa_required")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  siteRoles     UserSiteRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Hashed refresh tokens for rotation + server-side revocation. Access tokens are
/// stateless JWTs; refresh tokens are opaque and revocable here.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Set when this token is rotated, pointing at its successor (reuse detection).
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// RBAC assignment: a role for a user, optionally scoped to one site.
/// site_id NULL = the role applies across all sites (e.g. SYS_ADMIN, AUDITOR).
model UserSiteRole {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id])
  role   String

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, siteId, role])
  @@index([userId])
  @@map("user_site_roles")
}

// ---------------------------------------------------------------------------
// Reference data (minimal here; rates/thresholds/delegation land in the next S1 PR)
// ---------------------------------------------------------------------------

model Site {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  type     String
  /// Set when a site maps to a client (mine sites); null for head office.
  clientId String? @map("client_id") @db.Uuid
  active   Boolean @default(true)
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId String? @map("entity_id") @db.Uuid
  entity   Entity? @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserSiteRole[]

  @@index([entityId])
  @@map("sites")
}

// ---------------------------------------------------------------------------
// Audit — append-only (no UPDATE/DELETE grants; enforced in the SQL migration)
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  action        AuditAction
  tableName     String      @map("table_name")
  recordId      String?     @map("record_id")
  before        Json?
  after         Json?
  correlationId String?     @map("correlation_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tableName, recordId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Reference data — all effective-dated, append-only where noted (spec S1)
// ---------------------------------------------------------------------------

/// Append-only, effective-dated FX rates (official + parallel/street). Never overwritten;
/// a newer effective date supersedes. `rateAsOf(date, type)` reads the latest ≤ date.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  dateEffective DateTime @map("date_effective")
  currencyPair  String   @map("currency_pair") // e.g. "USD/ZWG"
  officialRate  Decimal  @map("official_rate") @db.Decimal(20, 6)
  parallelRate  Decimal? @map("parallel_rate") @db.Decimal(20, 6)
  source        String?
  enteredBy     String?  @map("entered_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([currencyPair, dateEffective])
  @@map("exchange_rates")
}

/// Effective-dated statutory parameters (VAT %, ZIMRA interest %, NSSA/ZIMDEF/NEC/MIPF,
/// PAYE bands per currency as JSON). Config, never hardcoded.
model StatutoryRate {
  id            String   @id @default(uuid()) @db.Uuid
  key           String // vat_pct, zimra_interest_pct, nssa_*, zimdef_pct, paye_bands, aids_levy_pct
  currency      String?
  /// ISO-3166 alpha-2 country this rate applies to. NULL = country-agnostic (the
  /// Zimbabwe default: all pre-existing rows). A country-specific row overrides the
  /// NULL fallback for that country, giving each entity its own statutory schedule.
  country       String?
  value         Decimal? @db.Decimal(20, 6)
  params        Json?
  dateEffective DateTime @map("date_effective")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([key, currency, dateEffective])
  @@index([key, country, currency, dateEffective])
  @@map("statutory_rates")
}

/// Effective-dated thresholds + tunable parameters (petty-cash FD threshold per currency,
/// SLA timers, danger-rule params).
model Threshold {
  id            String   @id @default(uuid()) @db.Uuid
  key           String // petty_cash_fd_threshold, sla_reminder_hours, danger_cash_runway_weeks
  currency      String?
  value         Decimal? @db.Decimal(20, 6)
  params        Json?
  dateEffective DateTime @default(now()) @map("date_effective")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([key, currency, dateEffective])
  @@map("thresholds")
}

/// Approver → alternate substitution for a date range (used by the approval engine).
model DelegationRule {
  id             String   @id @default(uuid()) @db.Uuid
  approverUserId String   @map("approver_user_id") @db.Uuid
  delegateUserId String   @map("delegate_user_id") @db.Uuid
  dateFrom       DateTime @map("date_from")
  dateTo         DateTime @map("date_to")
  active         Boolean  @default(true)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([approverUserId, active])
  @@map("delegation_rules")
}

// ---------------------------------------------------------------------------
// Notifications (spec S1) — channel abstraction with per-user preferences
// ---------------------------------------------------------------------------

enum NotificationSeverity {
  INFO
  WATCH
  DANGER
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  TEAMS
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  template     String
  payload      Json?
  severity     NotificationSeverity @default(INFO)
  subjectTable String?              @map("subject_table")
  subjectId    String?              @map("subject_id")
  readAt       DateTime?            @map("read_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

// ---------------------------------------------------------------------------
// Generic approval engine (spec S2, Prompt 3) — one engine used by all modules.
// ---------------------------------------------------------------------------

/// How the approvers within a single step order must act.
///  - SEQUENTIAL: one role per step_order; steps advance one by one.
///  - PARALLEL: every approver row sharing a step_order must approve.
///  - EITHER: any one approver row in the step_order suffices.
enum ApprovalMode {
  SEQUENTIAL
  PARALLEL
  EITHER
}

/// The decision recorded on an individual approval step row.
enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

/// The lifecycle status of an approval chain instance.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

/// Configuration: which roles approve which module, in which amount band, in which
/// order and mode. Rows are selected at submit time to instantiate a chain.
model ApprovalMatrix {
  id           String       @id @default(uuid()) @db.Uuid
  module       String // e.g. "requisition", "payment"
  minAmount    Decimal?     @map("min_amount") @db.Decimal(20, 2)
  maxAmount    Decimal?     @map("max_amount") @db.Decimal(20, 2)
  currency     String?
  siteId       String?      @map("site_id") @db.Uuid
  stepOrder    Int          @map("step_order")
  approverRole String       @map("approver_role")
  mode         ApprovalMode @default(SEQUENTIAL)
  active       Boolean      @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([module, active])
  @@map("approval_matrix")
}

/// One chain instance per submitted subject (e.g. a specific requisition).
model ApprovalChain {
  id           String         @id @default(uuid()) @db.Uuid
  module       String
  subjectTable String         @map("subject_table")
  subjectId    String         @map("subject_id") @db.Uuid
  amount       Decimal?       @db.Decimal(20, 2)
  currency     String?
  siteId       String?        @map("site_id") @db.Uuid
  requesterId  String         @map("requester_id") @db.Uuid
  status       ApprovalStatus @default(PENDING)
  currentStep  Int            @default(1) @map("current_step")
  createdAt    DateTime       @default(now()) @map("created_at")

  steps Approval[]

  @@index([subjectTable, subjectId])
  @@index([status])
  @@map("approval_chains")
}

/// A single approval step within a chain, resolved from an approval_matrix row.
model Approval {
  id              String            @id @default(uuid()) @db.Uuid
  chainId         String            @map("chain_id") @db.Uuid
  chain           ApprovalChain     @relation(fields: [chainId], references: [id], onDelete: Cascade)
  step            Int
  approverRole    String            @map("approver_role")
  /// Resolved via delegation when a named approver is substituted; null = match by role.
  assignedUserId  String?           @map("assigned_user_id") @db.Uuid
  mode            ApprovalMode      @default(SEQUENTIAL)
  decision        ApprovalDecision?
  decidedByUserId String?           @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?         @map("decided_at")
  comment         String?
  createdAt       DateTime          @default(now()) @map("created_at")
  /// When this step became active (SLA clock start), plus reminder/escalation stamps.
  activatedAt     DateTime          @default(now()) @map("activated_at")
  remindedAt      DateTime?         @map("reminded_at")
  escalatedAt     DateTime?         @map("escalated_at")

  @@index([chainId])
  @@map("approvals")
}

// ---------------------------------------------------------------------------
// S3 Financial core (spec Prompt 4) — clients, contracts, orders, expenses,
// loans, accounts/ledger and the tax tables. Monetary amounts follow the money
// rule: (amount, currency, fx_rate_id, rate_type) — never a bare number.
// Appendix A calculations live in separate pure services (not here).
// ---------------------------------------------------------------------------

enum LoanInterestMethod {
  FLAT
  REDUCING
}

enum LoanStatus {
  ACTIVE
  SETTLED
}

enum TaxType {
  VAT
  PAYE
}

/// A billed customer (mine site operator). Sites may map to a client via site.client_id.
model Client {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  contactEmail String? @map("contact_email")
  active       Boolean @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  contracts Contract[]
  orders    Order[]

  @@map("clients")
}

/// A revenue contract with a client. Value is VAT-exclusive money.
model Contract {
  id         String   @id @default(uuid()) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  client     Client   @relation(fields: [clientId], references: [id])
  reference  String
  valueExVat Decimal  @map("value_ex_vat") @db.Decimal(20, 2)
  currency   String
  fxRateId   String?  @map("fx_rate_id") @db.Uuid
  rateType   String?  @map("rate_type")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  status     String   @default("UPCOMING") // validated against the lookup catalog ('contract_status')
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId   String?  @map("entity_id") @db.Uuid
  entity     Entity?  @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  claims ContractClaim[]
  orders Order[]         @relation("OrderContract")

  @@index([clientId])
  @@index([entityId])
  @@map("contracts")
}

/// A progress claim raised against a contract. Amount is VAT-exclusive money.
model ContractClaim {
  id          String   @id @default(uuid()) @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  contract    Contract @relation(fields: [contractId], references: [id])
  amountExVat Decimal  @map("amount_ex_vat") @db.Decimal(20, 2)
  currency    String
  fxRateId    String?  @map("fx_rate_id") @db.Uuid
  rateType    String?  @map("rate_type")
  claimDate   DateTime @map("claim_date")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([contractId])
  @@map("contract_claims")
}

/// A work order for a client, optionally tied to a contract. Value is VAT-exclusive money.
model Order {
  id             String    @id @default(uuid()) @db.Uuid
  clientId       String    @map("client_id") @db.Uuid
  client         Client    @relation(fields: [clientId], references: [id])
  contractId     String?   @map("contract_id") @db.Uuid
  contract       Contract? @relation("OrderContract", fields: [contractId], references: [id])
  reference      String
  valueExVat     Decimal   @map("value_ex_vat") @db.Decimal(20, 2)
  currency       String
  fxRateId       String?   @map("fx_rate_id") @db.Uuid
  rateType       String?   @map("rate_type")
  closingDate    DateTime? @map("closing_date")
  serviced       Boolean   @default(false)
  servicedAt     DateTime? @map("serviced_at")
  /// Last OrderHealth state persisted by the nightly recalc job (null until first run).
  /// Used to detect transitions INTO a red state so alerts fire once, not every night.
  lastHealth        String?   @map("last_health")
  healthEvaluatedAt DateTime? @map("health_evaluated_at")
  /// The user responsible for servicing this order (sees it in their "My Orders").
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId       String?   @map("entity_id") @db.Uuid
  entity         Entity?   @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  receipts OrderReceipt[]
  expenses OrderExpense[]

  @@index([clientId])
  @@index([contractId])
  @@index([assignedUserId])
  @@index([entityId])
  @@map("orders")
}

/// A payment received against an order. Amount is money.
model OrderReceipt {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  order        Order    @relation(fields: [orderId], references: [id])
  amount       Decimal  @db.Decimal(20, 2)
  currency     String
  fxRateId     String?  @map("fx_rate_id") @db.Uuid
  rateType     String?  @map("rate_type")
  receivedDate DateTime @map("received_date")
  reference    String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("order_receipts")
}

/// A cost booked against an order. Amount is money; VAT may be claimable.
model OrderExpense {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  order        Order   @relation(fields: [orderId], references: [id])
  amount       Decimal @db.Decimal(20, 2)
  currency     String
  fxRateId     String? @map("fx_rate_id") @db.Uuid
  rateType     String? @map("rate_type")
  vatClaimable Boolean @default(false) @map("vat_claimable")
  description  String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("order_expenses")
}

/// A non-order-specific expense (overhead-adjacent). Amount is money.
model GeneralExpense {
  id           String   @id @default(uuid()) @db.Uuid
  amount       Decimal  @db.Decimal(20, 2)
  currency     String
  fxRateId     String?  @map("fx_rate_id") @db.Uuid
  rateType     String?  @map("rate_type")
  vatClaimable Boolean  @map("vat_claimable")
  category     String?
  expenseDate  DateTime @map("expense_date")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("general_expenses")
}

/// A recurring/periodic overhead cost. Amount is money.
model Overhead {
  id          String  @id @default(uuid()) @db.Uuid
  amount      Decimal @db.Decimal(20, 2)
  currency    String
  fxRateId    String? @map("fx_rate_id") @db.Uuid
  rateType    String? @map("rate_type")
  category    String?
  periodMonth String? @map("period_month")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("overheads")
}

/// A borrowing. Principal is money; interest accrues per weekly_rate_pct via a pure service.
model Loan {
  id             String             @id @default(uuid()) @db.Uuid
  lender         String
  principal      Decimal            @db.Decimal(20, 2)
  currency       String
  fxRateId       String?            @map("fx_rate_id") @db.Uuid
  rateType       String?            @map("rate_type")
  weeklyRatePct  Decimal            @map("weekly_rate_pct") @db.Decimal(20, 6)
  interestMethod LoanInterestMethod @default(FLAT) @map("interest_method")
  startDate      DateTime           @map("start_date")
  status         LoanStatus         @default(ACTIVE)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  repayments LoanRepayment[]
  interest   LoanInterest[]

  @@map("loans")
}

/// A repayment against a loan. Amount is money.
model LoanRepayment {
  id         String   @id @default(uuid()) @db.Uuid
  loanId     String   @map("loan_id") @db.Uuid
  loan       Loan     @relation(fields: [loanId], references: [id])
  amount     Decimal  @db.Decimal(20, 2)
  currency   String
  fxRateId   String?  @map("fx_rate_id") @db.Uuid
  rateType   String?  @map("rate_type")
  repaidDate DateTime @map("repaid_date")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([loanId])
  @@map("loan_repayments")
}

/// Idempotent per-day interest accrual for a loan (written by the interest service).
model LoanInterest {
  id          String   @id @default(uuid()) @db.Uuid
  loanId      String   @map("loan_id") @db.Uuid
  loan        Loan     @relation(fields: [loanId], references: [id])
  accrualDate DateTime @map("accrual_date") @db.Date
  amount      Decimal  @db.Decimal(20, 2)
  currency    String
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([loanId, accrualDate])
  @@index([loanId])
  @@map("loan_interest")
}

/// A cash/bank/wallet account, optionally scoped to a site.
model Account {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  type     String // validated against the admin lookup catalog (category 'account_type')
  currency String
  siteId   String? @map("site_id") @db.Uuid
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId String? @map("entity_id") @db.Uuid
  entity   Entity? @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@index([entityId])
  @@map("accounts")
}

/// A double-entry-style ledger line against an account.
model LedgerEntry {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id])
  debit       Decimal  @default(0) @db.Decimal(20, 2)
  credit      Decimal  @default(0) @db.Decimal(20, 2)
  currency    String
  sourceTable String?  @map("source_table")
  sourceId    String?  @map("source_id") @db.Uuid
  entryDate   DateTime @map("entry_date")
  description String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@index([sourceTable, sourceId])
  @@map("ledger_entries")
}

/// Running tax obligation per type + period (VAT/PAYE). Amounts are money.
model TaxLedger {
  id          String  @id @default(uuid()) @db.Uuid
  taxType     TaxType @map("tax_type")
  periodMonth String  @map("period_month")
  amountDue   Decimal @map("amount_due") @db.Decimal(20, 2)
  amountPaid  Decimal @default(0) @map("amount_paid") @db.Decimal(20, 2)
  currency    String
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId    String? @map("entity_id") @db.Uuid
  entity      Entity? @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@map("tax_ledger")
}

/// Other outstanding tax debt with its own interest rate.
model OtherTaxDebt {
  id         String   @id @default(uuid()) @db.Uuid
  taxType    TaxType  @map("tax_type")
  principal  Decimal  @db.Decimal(20, 2)
  /// Amount already paid against this brought-forward debt (workbook "Paid to Date").
  paidToDate Decimal  @default(0) @map("paid_to_date") @db.Decimal(20, 2)
  currency   String
  dueDate    DateTime @map("due_date")
  ratePct    Decimal  @map("rate_pct") @db.Decimal(20, 6)
  /// Accrued statutory interest persisted by the nightly ZIMRA-interest job (A.6):
  /// principal_outstanding * ratePct/100 * daysOverdue/365. Null until first accrual;
  /// balance/total-due stay derived on read. accruedInterestAt records the "as of" date.
  accruedInterest   Decimal?  @map("accrued_interest") @db.Decimal(20, 2)
  accruedInterestAt DateTime? @map("accrued_interest_at")
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId  String?  @map("entity_id") @db.Uuid
  entity    Entity?  @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@map("other_tax_debt")
}

/// A ZIMRA assessment raised against the business. Assessed amount is money.
model ZimraAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  taxType        TaxType  @map("tax_type")
  assessedAmount Decimal  @map("assessed_amount") @db.Decimal(20, 2)
  currency       String
  dueDate        DateTime @map("due_date")
  /// Accrued statutory interest persisted by the nightly ZIMRA-interest job (A.6),
  /// using the statutory `zimra_interest_pct` rate: assessedAmount * rate/100 * daysOverdue/365.
  /// Null until first accrual; total-due stays derived on read.
  accruedInterest   Decimal?  @map("accrued_interest") @db.Decimal(20, 2)
  accruedInterestAt DateTime? @map("accrued_interest_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("zimra_assessments")
}

// ---------------------------------------------------------------------------
// Workflows — Cash Requisitions (spec §8 / Prompt 6.1)
// ---------------------------------------------------------------------------

/// A cash requisition. Follows the shared workflow lifecycle: DRAFT -> SUBMITTED ->
/// APPROVED|REJECTED|RETURNED -> (funds check) APPROVED_READY_TO_PAY |
/// APPROVED_PENDING_FUNDS -> DISBURSED -> CLOSED. Approval is merit-only; funds
/// availability never blocks approval, it only picks READY_TO_PAY vs PENDING_FUNDS.
model Requisition {
  id                    String    @id @default(uuid()) @db.Uuid
  purpose               String
  amount                Decimal   @db.Decimal(20, 2)
  currency              String
  requiredByDate        DateTime  @map("required_by_date")
  /// Optional link to the order this requisition funds.
  orderId               String?   @map("order_id") @db.Uuid
  attachmentKey         String?   @map("attachment_key")
  siteId                String?   @map("site_id") @db.Uuid
  requesterId           String    @map("requester_id") @db.Uuid
  status                String    @default("DRAFT")
  /// Cash position captured at the moment the funds check ran.
  cashSnapshot          Json?     @map("cash_snapshot")
  /// Amount by which the chosen account fell short at funds-check time (PENDING_FUNDS only).
  shortfall             Decimal?  @db.Decimal(20, 2)
  disbursementAccountId String?   @map("disbursement_account_id") @db.Uuid
  disbursementReference String?   @map("disbursement_reference")
  disbursedAt           DateTime? @map("disbursed_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([requesterId])
  @@index([siteId])
  @@map("requisitions")
}

// ---------------------------------------------------------------------------
// Workflows — Travel Allowances (spec §8 / Prompt 6.2)
// ---------------------------------------------------------------------------

/// Admin-managed effective-dated per-diem rate table. The daily rate applied to a travel
/// request is the most recent row for the (grade, destinationClass, currency) tuple whose
/// effectiveDate is on or before the trip's dateFrom. Config, never hardcoded.
model TravelRate {
  id               String   @id @default(uuid()) @db.Uuid
  grade            String
  destinationClass String   @map("destination_class")
  currency         String
  dailyRate        Decimal  @map("daily_rate") @db.Decimal(20, 2)
  effectiveDate    DateTime @map("effective_date")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([grade, destinationClass, currency, effectiveDate])
  @@map("travel_rates")
}

/// A travel allowance / advance request. Follows the shared workflow lifecycle plus a
/// travel-only retirement step: DRAFT -> SUBMITTED -> APPROVED|REJECTED|RETURNED ->
/// (funds check) APPROVED_READY_TO_PAY | APPROVED_PENDING_FUNDS -> DISBURSED -> RETIRED ->
/// CLOSED. Approval is merit-only; funds availability never blocks approval, it only picks
/// READY_TO_PAY vs PENDING_FUNDS. On retirement the traveller's unspent advance drives
/// refundDue (owed BACK to the business) or refundOwed (owed TO the traveller).
model TravelRequest {
  id               String   @id @default(uuid()) @db.Uuid
  destination      String
  destinationClass String?  @map("destination_class")
  dateFrom         DateTime @map("date_from")
  dateTo           DateTime @map("date_to")
  grade            String?
  /// Per-day allowance resolved from the travel_rates table at submit time.
  perDiem          Decimal  @map("per_diem") @db.Decimal(20, 2)
  days             Int
  /// Total advance requested = perDiem * days.
  advanceAmount    Decimal  @map("advance_amount") @db.Decimal(20, 2)
  currency         String
  siteId           String?  @map("site_id") @db.Uuid
  requesterId      String   @map("requester_id") @db.Uuid
  status           String   @default("DRAFT")
  /// Cash position captured at the moment the funds check ran.
  cashSnapshot     Json?    @map("cash_snapshot")
  /// Amount by which the chosen account fell short at funds-check time (PENDING_FUNDS only).
  shortfall        Decimal? @db.Decimal(20, 2)

  disbursementAccountId String?   @map("disbursement_account_id") @db.Uuid
  disbursementReference String?   @map("disbursement_reference")
  disbursedAt           DateTime? @map("disbursed_at")

  /// Retirement: storage key of the supporting receipts pack and the reconciliation result.
  retirementReceiptsKey String?   @map("retirement_receipts_key")
  /// Cash the traveller must refund BACK to the business (unspent advance).
  refundDue             Decimal?  @map("refund_due") @db.Decimal(20, 2)
  /// Cash the business owes TO the traveller (spent beyond the advance).
  refundOwed            Decimal?  @map("refund_owed") @db.Decimal(20, 2)
  retiredAt             DateTime? @map("retired_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([requesterId])
  @@index([siteId])
  @@map("travel_requests")
}

// ---------------------------------------------------------------------------
// Workflows — Petty Cash (spec §9 / Prompt 6.3)
// ---------------------------------------------------------------------------

/// A petty-cash float held per site per currency by a named custodian. Its live balance is
/// derived from petty_cash_txns (posted withdrawals draw it down; top-ups/conversion-ins
/// replenish it). `locked` is set by reconciliation when a cash count reveals a variance
/// beyond tolerance and blocks further withdrawals until an FD clears it.
model PettyCashFloat {
  id              String  @id @default(uuid()) @db.Uuid
  siteId          String  @map("site_id") @db.Uuid
  currency        String
  custodianUserId String  @map("custodian_user_id") @db.Uuid
  /// The imprest/nominal float amount this custodian is entrusted with.
  floatAmount     Decimal @map("float_amount") @db.Decimal(20, 2)
  /// Set true by reconciliation when a counted variance exceeds tolerance; blocks withdrawals.
  locked          Boolean @default(false)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  txns PettyCashTxn[]

  @@index([siteId, currency])
  @@index([custodianUserId])
  @@map("petty_cash_floats")
}

/// A single movement against a petty-cash float. `type` is one of
/// WITHDRAWAL | TOP_UP | CONVERSION_OUT | CONVERSION_IN. Conversions come in two linked legs
/// (an OUT leg and an IN leg) referencing each other via `linkedTxnId`, carrying the achieved
/// rate and the variance vs the official rate of the day. `status` follows the shared lifecycle
/// (DRAFT/SUBMITTED/APPROVED.../POSTED) — below-threshold withdrawals post immediately after a
/// Site Manager confirm; at/above threshold they require FD approval before cash leaves.
model PettyCashTxn {
  id                 String         @id @default(uuid()) @db.Uuid
  floatId            String         @map("float_id") @db.Uuid
  float              PettyCashFloat @relation(fields: [floatId], references: [id])
  type               String // WITHDRAWAL | TOP_UP | CONVERSION_OUT | CONVERSION_IN
  amount             Decimal        @db.Decimal(20, 2)
  currency           String
  purpose            String?
  /// Optional link to the order this petty-cash spend relates to.
  orderId            String?        @map("order_id") @db.Uuid
  /// Storage key of the receipt photo/attachment supporting the voucher.
  receiptKey         String?        @map("receipt_key")
  /// Conversions only: the rate actually achieved on the street for the swap.
  achievedRate       Decimal?       @map("achieved_rate") @db.Decimal(20, 6)
  /// Conversions only: achievedRate minus the official rate of the day (loss/gain signal).
  varianceVsOfficial Decimal?       @map("variance_vs_official") @db.Decimal(20, 6)
  /// The paired conversion leg (OUT <-> IN).
  linkedTxnId        String?        @map("linked_txn_id") @db.Uuid
  status             String         @default("DRAFT")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([floatId])
  @@index([type])
  @@index([status])
  @@map("petty_cash_txns")
}

// ---------------------------------------------------------------------------
// Workflows — Budgets (spec §10 / Prompt 6.4)
// ---------------------------------------------------------------------------

/// A budget for an optional site + period, made of one or more category lines. Follows the
/// shared workflow lifecycle but resolves under a PARALLEL co-approval by BOTH the Ops Director
/// and the Finance Director (module='budget'): the budget only becomes ACTIVE once both approve.
/// A Return sends it back for correction and re-submission. Active budgets track actuals
/// (order_expenses + general_expenses + overheads + requisitions) per line/category, warning at
/// 85% and alerting at 100% (thresholds configurable). Revisions clone the budget to a new
/// version (a fresh approvable); Budget Change Requests reuse the same dual-approval path.
model Budget {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  /// Optional budget period, stored as an ISO month string e.g. "2026-07".
  periodMonth    String? @map("period_month")
  siteId         String? @map("site_id") @db.Uuid
  currency       String
  status         String  @default("DRAFT")
  version        Int     @default(1)
  /// When a revision clones this budget, the clone points back at its predecessor.
  parentBudgetId String? @map("parent_budget_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  lines BudgetLine[]

  @@index([status])
  @@index([siteId])
  @@index([parentBudgetId])
  @@map("budgets")
}

/// A single category line of a budget carrying the budgeted amount for that category.
model BudgetLine {
  id          String  @id @default(uuid()) @db.Uuid
  budgetId    String  @map("budget_id") @db.Uuid
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category    String
  description String?
  amount      Decimal @db.Decimal(20, 2)
  currency    String

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([budgetId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------------------
// Workflows — Director Withdrawals (spec §11 / Prompt 6.5)
// ---------------------------------------------------------------------------

/// A withdrawal raised by a director against a company account. It requires co-approval by a
/// SECOND director (self-approval is impossible — enforced by the approval engine). Once the
/// co-approval chain resolves APPROVED an informational funds check runs and the movement is
/// posted to the ledger immediately as "Posted — Awaiting Transfer" so the cash position
/// reflects it at once; a human then performs the actual bank transfer and calls complete()
/// (which must be a different user than the requester) to record the method/reference and
/// close it.
model DirectorWithdrawal {
  id                 String  @id @default(uuid()) @db.Uuid
  directorUserId     String  @map("director_user_id") @db.Uuid
  amount             Decimal @db.Decimal(20, 2)
  currency           String
  destinationAccount String  @map("destination_account")
  reason             String
  status             String  @default("DRAFT")

  transferMethod    String?   @map("transfer_method")
  transferReference String?   @map("transfer_reference")
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime? @map("completed_at")
  /// Set when the withdrawal is posted to the ledger (immediately on co-approval).
  ledgerPostedAt    DateTime? @map("ledger_posted_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([directorUserId])
  @@map("director_withdrawals")
}

// ---------------------------------------------------------------------------
// Command Centre — Danger Engine (spec §14.2 / Prompt 7)
// ---------------------------------------------------------------------------

/// Alert severity ladder. INFO = informational, WATCH = elevated attention,
/// DANGER = act now (fans out to all Directors and repeats until acknowledged).
enum AlertSeverity {
  INFO
  WATCH
  DANGER
}

/// A tunable danger rule. `ruleKey` is the stable identifier the engine dispatches on
/// (e.g. cash_runway, coverage_ratio, zimra_overdue); `params` holds the rule-specific
/// thresholds as JSON. Seeded idempotently via DangerRulesService.seedDefaults().
model DangerRule {
  id       String        @id @default(uuid()) @db.Uuid
  ruleKey  String        @unique @map("rule_key")
  params   Json
  severity AlertSeverity
  enabled  Boolean       @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("danger_rules")
}

/// An alert raised by the danger engine. Deduped per (ruleKey, subjectId) while active
/// (resolvedAt null, acknowledgedAt null) — an existing active alert is refreshed rather
/// than duplicated. `acknowledgedByUserId`/`acknowledgedAt` capture the human ack;
/// `resolvedAt` is set when the underlying condition clears.
model Alert {
  id                   String        @id @default(uuid()) @db.Uuid
  ruleKey              String        @map("rule_key")
  severity             AlertSeverity
  subjectTable         String?       @map("subject_table")
  subjectId            String?       @map("subject_id") @db.Uuid
  message              String
  payload              Json?
  raisedAt             DateTime      @default(now()) @map("raised_at")
  acknowledgedByUserId String?       @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAt       DateTime?     @map("acknowledged_at")
  resolvedAt           DateTime?     @map("resolved_at")
  createdAt            DateTime      @default(now()) @map("created_at")

  @@index([ruleKey, subjectId, resolvedAt])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// HR-LITE — employee master + timesheets (spec §12 / Prompt 9)
// ---------------------------------------------------------------------------

/// Lifecycle of a monthly timesheet period. OPEN accepts edits; SITE_APPROVED is set
/// after the Site Manager approval chain resolves; LOCKED is immutable and is the only
/// state (with SITE_APPROVED) that payroll may read from.
enum TimesheetPeriodStatus {
  OPEN
  SITE_APPROVED
  LOCKED
}

/// HR-lite employee master. Bank account numbers are masked (last 4 only) in read DTOs;
/// the raw value is only ever used by payroll (S9+). `userId` optionally links to a login.
model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  worksNo         String    @unique @map("works_no")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  nationalId      String?   @map("national_id")
  nssaNo          String?   @map("nssa_no")
  grade           String?
  necClass        String?   @map("nec_class")
  occupation      String?
  siteId          String    @map("site_id") @db.Uuid
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId        String?   @map("entity_id") @db.Uuid
  entity          Entity?   @relation(fields: [entityId], references: [id])
  employmentType  String    @map("employment_type")
  payMode         String    @map("pay_mode")
  /// Only meaningful when payMode = FIXED_SPLIT: the fixed USD percentage (0..100).
  fixedUsdPct     Decimal?  @map("fixed_usd_pct") @db.Decimal(5, 2)
  hourlyRate      Decimal?  @map("hourly_rate") @db.Decimal(20, 4)
  /// Per-employee USD/ZWG split ratio (0..100) applied to the USD-native gross; overrides the
  /// client/fixed split for both legs when set. The paysheets carry a distinct ratio per person.
  usdSplitPct        Decimal? @map("usd_split_pct") @db.Decimal(5, 2)
  /// Allowance paid per underground shift (USD). Feeds the UG shift allowance earning.
  ugAllowanceRate    Decimal? @map("ug_allowance_rate") @db.Decimal(20, 4)
  /// Allowance paid per night-shift hour (USD). Feeds the night allowance earning.
  nightAllowanceRate Decimal? @map("night_allowance_rate") @db.Decimal(20, 4)
  /// Flat cost-of-living allowance, ZWG-native (goes entirely to the ZWG leg).
  colaZwg            Decimal? @map("cola_zwg") @db.Decimal(20, 2)
  /// Flat other allowances, USD-native (the paysheet "Allowances USD" column).
  otherAllowancesUsd Decimal? @map("other_allowances_usd") @db.Decimal(20, 2)
  /// Flat monthly gratuity, USD-native.
  gratuityUsd        Decimal? @map("gratuity_usd") @db.Decimal(20, 2)
  /// Voluntary Nyaradzo policy deduction taken off net each run.
  nyaradzoAmount     Decimal? @map("nyaradzo_amount") @db.Decimal(20, 2)
  /// Currency of the Nyaradzo deduction (USD or ZWG); defaults to ZWG at compute time.
  nyaradzoCurrency   String?  @map("nyaradzo_currency")
  /// Flat recurring other deduction on the USD leg (e.g. May Day levy).
  otherDeductionUsd  Decimal? @map("other_deduction_usd") @db.Decimal(20, 2)
  /// Flat recurring other deduction on the ZWG leg.
  otherDeductionZwg  Decimal? @map("other_deduction_zwg") @db.Decimal(20, 2)
  /// Whether the employee is enrolled in MIPF (Mining Industry Pension Fund).
  mipfMember         Boolean  @default(false) @map("mipf_member")
  /// Whether the employee falls under a NEC (National Employment Council) that levies dues.
  necMember          Boolean  @default(false) @map("nec_member")
  bankName        String?   @map("bank_name")
  bankBranch      String?   @map("bank_branch")
  accountNo       String?   @map("account_no")
  accountCurrency String?   @map("account_currency")
  leaveBalance    Decimal   @default(0) @map("leave_balance") @db.Decimal(10, 2)
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  /// Optional link to the users table (an employee that also has a login).
  userId          String?   @map("user_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  timesheetEntries TimesheetEntry[]

  @@index([siteId])
  @@index([entityId])
  @@map("employees")
}

/// A monthly timesheet period per site. One period per (site, month). Entries hang off it.
model TimesheetPeriod {
  id               String                @id @default(uuid()) @db.Uuid
  siteId           String                @map("site_id") @db.Uuid
  /// Calendar month in YYYY-MM.
  month            String
  status           TimesheetPeriodStatus @default(OPEN)
  approvedByUserId String?               @map("approved_by_user_id") @db.Uuid
  lockedAt         DateTime?             @map("locked_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  entries TimesheetEntry[]

  @@unique([siteId, month])
  @@index([siteId])
  @@map("timesheet_periods")
}

/// One employee-day row in a timesheet period. Hours are split by category; category
/// exclusivity + a configurable max-hours/day are enforced at write time in the service.
model TimesheetEntry {
  id          String          @id @default(uuid()) @db.Uuid
  periodId    String          @map("period_id") @db.Uuid
  period      TimesheetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId  String          @map("employee_id") @db.Uuid
  employee    Employee        @relation(fields: [employeeId], references: [id])
  date        DateTime        @db.Date
  hoursNormal Decimal         @default(0) @map("hours_normal") @db.Decimal(6, 2)
  hoursOt15   Decimal         @default(0) @map("hours_ot15") @db.Decimal(6, 2)
  hoursOt20   Decimal         @default(0) @map("hours_ot20") @db.Decimal(6, 2)
  ugShift     Decimal         @default(0) @map("ug_shift") @db.Decimal(6, 2)
  nightHours  Decimal         @default(0) @map("night_hours") @db.Decimal(6, 2)
  remarks     String?
  /// Placeholder anomaly flag — set when a heuristic (S9+) flags the row for review.
  anomalyFlag Boolean         @default(false) @map("anomaly_flag")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([periodId, employeeId, date])
  @@index([periodId])
  @@index([employeeId])
  @@map("timesheet_entries")
}

// ---------------------------------------------------------------------------
// Payroll engine (spec §13 / Prompt 10)
// ---------------------------------------------------------------------------

/// Lifecycle of a monthly payroll run. DRAFT is created once a site+month timesheet is
/// SITE_APPROVED/LOCKED; CHECKED after compute; APPROVED after the Finance-Director chain
/// resolves and the employer cost posts to the ledger; PAID once disbursed; LOCKED is the
/// terminal immutable state (corrections are made via a reversing correcting run, never by
/// mutating a locked run).
enum PayrollRunStatus {
  DRAFT
  CHECKED
  APPROVED
  PAID
  LOCKED
}

/// A monthly payroll run for one site. One run per (site, month). The chosen FX rate and the
/// governing client USD/ZWG ratio are snapshotted at open time so a run is reproducible even
/// if reference data changes later.
model PayrollRun {
  id                  String           @id @default(uuid()) @db.Uuid
  siteId              String           @map("site_id") @db.Uuid
  /// Calendar month in YYYY-MM.
  month               String
  status              PayrollRunStatus @default(DRAFT)
  /// The exchange_rates row snapshotted for this run (USD/ZWG conversions).
  fxRateId            String?          @map("fx_rate_id") @db.Uuid
  /// Snapshot of the client USD/ZWG split ratio governing the run at open time.
  clientRatioSnapshot Json?            @map("client_ratio_snapshot")
  /// Optional per-employee USD split ratios for this run: `{ "<employeeId>": <usdPct 0..100> }`.
  /// Overrides the employee/client/fixed split so a run can match the paysheet's per-person ratio.
  perEmployeeRatios   Json?            @map("per_employee_ratios")
  /// The USD/ZWG FX rate snapshotted for this run (ZWG per 1 USD). PAYE is computed on the
  /// combined USD-equivalent taxable income using this rate, then split back per currency.
  fxRate              Decimal?         @map("fx_rate") @db.Decimal(20, 6)
  preparedByUserId    String?          @map("prepared_by_user_id") @db.Uuid
  approvedByUserId    String?          @map("approved_by_user_id") @db.Uuid
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId            String?          @map("entity_id") @db.Uuid
  entity              Entity?          @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  lines PayrollLine[]

  @@unique([siteId, month])
  @@index([siteId])
  @@index([entityId])
  @@map("payroll_runs")
}

/// One computed pay line per employee within a run. Gross is built from timesheet hours and
/// pay config; statutory deductions/contributions are computed per currency from effective
/// StatutoryRate config. Net = gross - paye - aidsLevy - nssaEe - otherDeductions, split USD/ZWG.
model PayrollLine {
  id              String     @id @default(uuid()) @db.Uuid
  runId           String     @map("run_id") @db.Uuid
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String     @map("employee_id") @db.Uuid
  basicUsd        Decimal    @default(0) @map("basic_usd") @db.Decimal(20, 2)
  basicZwg        Decimal    @default(0) @map("basic_zwg") @db.Decimal(20, 2)
  cola            Decimal    @default(0) @db.Decimal(20, 2)
  ugAllowance     Decimal    @default(0) @map("ug_allowance") @db.Decimal(20, 2)
  nightAllowance  Decimal    @default(0) @map("night_allowance") @db.Decimal(20, 2)
  otherAllowances Decimal    @default(0) @map("other_allowances") @db.Decimal(20, 2)
  gross           Decimal    @default(0) @db.Decimal(20, 2)
  paye            Decimal    @default(0) @db.Decimal(20, 2)
  aidsLevy        Decimal    @default(0) @map("aids_levy") @db.Decimal(20, 2)
  nssaEe          Decimal    @default(0) @map("nssa_ee") @db.Decimal(20, 2)
  nssaEr          Decimal    @default(0) @map("nssa_er") @db.Decimal(20, 2)
  zimdef          Decimal    @default(0) @db.Decimal(20, 2)
  /// NEC employer contribution (company cost).
  nec             Decimal    @default(0) @db.Decimal(20, 2)
  /// NEC employee contribution (deducted from net).
  necEe           Decimal    @default(0) @map("nec_ee") @db.Decimal(20, 2)
  /// MIPF employer contribution (company cost).
  mipf            Decimal    @default(0) @db.Decimal(20, 2)
  /// MIPF employee contribution (deducted from net).
  mipfEe          Decimal    @default(0) @map("mipf_ee") @db.Decimal(20, 2)
  nyaradzo        Decimal    @default(0) @db.Decimal(20, 2)
  /// Approved back-pay / acting extra earnings folded into this line (from PayrollExtraEarning).
  extraEarnings   Decimal    @default(0) @map("extra_earnings") @db.Decimal(20, 2)
  otherDeductions Decimal    @default(0) @map("other_deductions") @db.Decimal(20, 2)
  netUsd          Decimal    @default(0) @map("net_usd") @db.Decimal(20, 2)
  netZwg          Decimal    @default(0) @map("net_zwg") @db.Decimal(20, 2)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([runId, employeeId])
  @@index([runId])
  @@index([employeeId])
  @@map("payroll_lines")
}

/// Statutory compliance calendar (spec §13/§16): one remittance obligation per head
/// per period (PAYE incl. AIDS levy, NSSA ee+er, ZIMDEF, NEC, MIPF), generated from an
/// approved payroll run with a statutory due date. Overdue/due-soon obligations feed the
/// danger engine; remittance capture records the reference + who paid.
model ComplianceObligation {
  id                  String    @id @default(uuid()) @db.Uuid
  head                String // PAYE | NSSA | ZIMDEF | NEC | MIPF | VAT
  label               String
  periodMonth         String    @map("period_month") // YYYY-MM
  siteId              String?   @map("site_id") @db.Uuid
  amount              Decimal   @db.Decimal(20, 2)
  currency            String
  dueDate             DateTime  @map("due_date")
  status              String    @default("PENDING") // PENDING | REMITTED
  sourceTable         String?   @map("source_table")
  sourceId            String?   @map("source_id") @db.Uuid
  remittanceReference String?   @map("remittance_reference")
  remittedByUserId    String?   @map("remitted_by_user_id") @db.Uuid
  remittedAt          DateTime? @map("remitted_at")
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId            String?   @map("entity_id") @db.Uuid
  entity              Entity?   @relation(fields: [entityId], references: [id])

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, dueDate])
  @@index([entityId])
  @@map("compliance_obligations")
}

// ---------------------------------------------------------------------------
// Settings — admin-managed lookup catalog (configurable reference values)
// ---------------------------------------------------------------------------

/// A configurable value in a named category (currency, site_type, statutory_key,
/// threshold_key, employment_type, pay_mode, role, currency_pair). Lets the admin
/// manage these lists without a code change; services validate inputs against active codes.
model LookupValue {
  id        String  @id @default(uuid()) @db.Uuid
  category  String
  code      String
  label     String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)
  /// Behavioural metadata, e.g. site_type {isMineSite:true}, pay_mode {splitMode:'client_ratio'},
  /// currency_pair {base:'USD', quote:'ZWG'}. System entries are marked {system:true}.
  metadata  Json?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, code])
  @@index([category, active])
  @@map("lookup_values")
}

// ---------------------------------------------------------------------------
// CRM core (spec §17 / Prompt 12) — lightweight business-development pipeline:
// organisations we deal with, their contacts, and logged interactions.
// ---------------------------------------------------------------------------

/// A type of logged touchpoint with an organisation/contact.
enum InteractionType {
  CALL
  VISIT
  EMAIL
  TENDER
  MEETING
}

/// The stage of a sales-pipeline opportunity as it moves toward WON or LOST.
enum OpportunityStage {
  CONTACT
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// A prospect/customer organisation tracked by business development. May link to an
/// existing billed Client once the relationship is converted (clientId is a soft link).
model CrmOrganisation {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  /// Soft link to a financial-core Client (no FK — orgs may exist before a client does).
  clientId    String? @map("client_id") @db.Uuid
  industry    String?
  source      String?
  ownerUserId String? @map("owner_user_id") @db.Uuid
  notes       String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts     CrmContact[]
  interactions CrmInteraction[]

  @@index([clientId])
  @@map("crm_organisations")
}

/// A person at an organisation.
model CrmContact {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  organisation   CrmOrganisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  email          String?
  phone          String?
  title          String?
  ownerUserId    String?         @map("owner_user_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  interactions CrmInteraction[]

  @@index([organisationId])
  @@map("crm_contacts")
}

/// A logged touchpoint (call/visit/email/tender/meeting) with an org and/or contact.
model CrmInteraction {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String?          @map("organisation_id") @db.Uuid
  organisation   CrmOrganisation? @relation(fields: [organisationId], references: [id])
  contactId      String?          @map("contact_id") @db.Uuid
  contact        CrmContact?      @relation(fields: [contactId], references: [id])
  type           InteractionType
  occurredAt     DateTime         @map("occurred_at")
  outcome        String?
  notes          String?
  byUserId       String?          @map("by_user_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([contactId])
  @@map("crm_interactions")
}

/// A sales-pipeline opportunity (deal) tracked through stages. When WON it may be
/// converted into a financial-core Order or Contract (soft links, no FK — the deal
/// records the id of the created order/contract for traceability).
model CrmOpportunity {
  id                  String           @id @default(uuid()) @db.Uuid
  title               String
  organisationId      String?          @map("organisation_id") @db.Uuid
  contactId           String?          @map("contact_id") @db.Uuid
  stage               OpportunityStage @default(CONTACT)
  estimatedValue      Decimal?         @map("estimated_value") @db.Decimal(20, 2)
  currency            String?
  ownerUserId         String?          @map("owner_user_id") @db.Uuid
  expectedCloseDate   DateTime?        @map("expected_close_date")
  wonAt               DateTime?        @map("won_at")
  lostReason          String?          @map("lost_reason")
  convertedOrderId    String?          @map("converted_order_id") @db.Uuid
  convertedContractId String?          @map("converted_contract_id") @db.Uuid
  /// Multinational/entity dimension (nullable; backfilled to the default entity).
  entityId            String?          @map("entity_id") @db.Uuid
  entity              Entity?          @relation(fields: [entityId], references: [id])
  /// Marketing attribution (soft links, no FK): the campaign + response that sourced this deal.
  campaignId          String?          @map("campaign_id") @db.Uuid
  responseId          String?          @map("response_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stage])
  @@index([ownerUserId])
  @@index([entityId])
  @@map("crm_opportunities")
}

// ===========================================================================
// ENTITY / MULTINATIONAL DIMENSION (Additional Features — Prompt 27)
// A legal operating entity (per country). Existing financial/HR tables carry an
// optional entity_id; new feature tables key off it. Not site-scoped (RLS off).
// ===========================================================================

/// A legal operating entity per country (multinational dimension). Existing rows are
/// backfilled to a single default entity (AES Zimbabwe) by the migration.
model Entity {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String  @unique
  /// ISO-3166 alpha-2 country code, e.g. "ZW".
  country            String
  baseCurrency       String  @map("base_currency")
  chartOfAccountsRef String? @map("chart_of_accounts_ref")
  timezone           String  @default("Africa/Harare")
  locale             String  @default("en")
  active             Boolean @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  sites                 Site[]
  employees             Employee[]
  orders                Order[]
  contracts             Contract[]
  accounts              Account[]
  payrollRuns           PayrollRun[]
  taxLedgers            TaxLedger[]
  otherTaxDebts         OtherTaxDebt[]
  complianceObligations ComplianceObligation[]
  crmOpportunities      CrmOpportunity[]
  publicHolidays        PublicHoliday[]

  @@map("entities")
}

/// A public holiday for an entity (localisation hook for working-day calculations).
model PublicHoliday {
  id       String   @id @default(uuid()) @db.Uuid
  entityId String   @map("entity_id") @db.Uuid
  entity   Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  date     DateTime
  name     String

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@map("public_holidays")
}

// ===========================================================================
// A) BD / MARKETING — campaigns, channels, weekly metrics and inbound responses.
// Not site-scoped (RLS off; GRANT only).
// ===========================================================================

/// A marketing / business-development campaign.
model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  entityId    String?   @map("entity_id") @db.Uuid
  name        String
  objective   String?
  audience    String?
  budget      Decimal?  @db.Decimal(20, 2)
  currency    String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  status      String    @default("PLANNED")
  ownerUserId String?   @map("owner_user_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  channels  CampaignChannel[]
  responses CampaignResponse[]

  @@index([entityId])
  @@map("campaigns")
}

/// A single delivery channel for a campaign (Facebook/LinkedIn/WhatsApp/X/Instagram/Expo/Flier).
model CampaignChannel {
  id           String   @id @default(uuid()) @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channelType  String   @map("channel_type")
  cost         Decimal  @default(0) @db.Decimal(20, 2)
  currency     String?
  trackingLink String?  @map("tracking_link")
  flierCode    String?  @map("flier_code")
  printRunQty  Int?     @map("print_run_qty")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  metrics   ChannelMetric[]
  responses CampaignResponse[]

  @@index([campaignId])
  @@map("campaign_channels")
}

/// A weekly performance snapshot for a campaign channel.
model ChannelMetric {
  id          String          @id @default(uuid()) @db.Uuid
  channelId   String          @map("channel_id") @db.Uuid
  channel     CampaignChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  weekOf      DateTime        @map("week_of")
  impressions Int             @default(0)
  engagements Int             @default(0)
  clicks      Int             @default(0)
  spend       Decimal         @default(0) @db.Decimal(20, 2)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([channelId])
  @@map("channel_metrics")
}

/// An inbound response/enquiry attributed to a campaign and/or channel. Converts to a
/// CRM opportunity (opportunityId) once qualified.
model CampaignResponse {
  id            String           @id @default(uuid()) @db.Uuid
  campaignId    String?          @map("campaign_id") @db.Uuid
  campaign      Campaign?        @relation(fields: [campaignId], references: [id])
  channelId     String?          @map("channel_id") @db.Uuid
  channel       CampaignChannel? @relation(fields: [channelId], references: [id])
  personName    String?          @map("person_name")
  orgName       String?          @map("org_name")
  contactEmail  String?          @map("contact_email")
  contactPhone  String?          @map("contact_phone")
  receivedAt    DateTime         @map("received_at")
  status        String           @default("NEW")
  howHeard      String?          @map("how_heard")
  ownerUserId   String?          @map("owner_user_id") @db.Uuid
  opportunityId String?          @map("opportunity_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([channelId])
  @@map("campaign_responses")
}

// ===========================================================================
// B) CONFIDENTIAL BOARDS ENGINE — Trello-style boards/lists/cards, with a
// director-confidential visibility mode. Not site-scoped (RLS off; GRANT only).
// ===========================================================================

/// Board visibility: TEAM (members) vs DIRECTOR_CONFIDENTIAL (directors only).
enum BoardVisibility {
  TEAM
  DIRECTOR_CONFIDENTIAL
}

/// A kanban board, optionally linked to a project.
model Board {
  id          String          @id @default(uuid()) @db.Uuid
  entityId    String?         @map("entity_id") @db.Uuid
  name        String
  description String?
  visibility  BoardVisibility @default(TEAM)
  ownerUserId String?         @map("owner_user_id") @db.Uuid
  projectId   String?         @map("project_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  members BoardMember[]
  lists   BoardList[]

  @@index([entityId])
  @@index([projectId])
  @@map("boards")
}

/// A member of a board (with an optional per-board role).
model BoardMember {
  id      String  @id @default(uuid()) @db.Uuid
  boardId String  @map("board_id") @db.Uuid
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String  @map("user_id") @db.Uuid
  role    String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([boardId, userId])
  @@index([boardId])
  @@map("board_members")
}

/// A list (column) within a board.
model BoardList {
  id       String @id @default(uuid()) @db.Uuid
  boardId  String @map("board_id") @db.Uuid
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  position Int    @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  cards BoardCard[]

  @@index([boardId])
  @@map("board_lists")
}

/// A card within a board list.
model BoardCard {
  id          String    @id @default(uuid()) @db.Uuid
  listId      String    @map("list_id") @db.Uuid
  list        BoardList @relation(fields: [listId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int       @default(0)
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueDate     DateTime? @map("due_date")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  checklistItems CardChecklistItem[]
  comments       CardComment[]

  @@index([listId])
  @@map("board_cards")
}

/// A checklist item on a card.
model CardChecklistItem {
  id       String    @id @default(uuid()) @db.Uuid
  cardId   String    @map("card_id") @db.Uuid
  card     BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean   @default(false)
  position Int       @default(0)

  @@index([cardId])
  @@map("card_checklist_items")
}

/// A comment on a card.
model CardComment {
  id        String    @id @default(uuid()) @db.Uuid
  cardId    String    @map("card_id") @db.Uuid
  card      BoardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String?   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([cardId])
  @@map("card_comments")
}

// ===========================================================================
// C) PROJECT WBS — projects with a work-breakdown-structure tree, dependencies,
// notes and reusable templates. `projects` is SITE-SCOPED (site_id → RLS on).
// ===========================================================================

/// The kind of node in a project work-breakdown structure.
enum ProjectNodeType {
  PHASE
  TASK
  SUBTASK
}

/// A project (site-scoped). Optionally linked to a contract/order.
model Project {
  id              String    @id @default(uuid()) @db.Uuid
  entityId        String?   @map("entity_id") @db.Uuid
  name            String
  description     String?
  siteId          String?   @map("site_id") @db.Uuid
  contractId      String?   @map("contract_id") @db.Uuid
  orderId         String?   @map("order_id") @db.Uuid
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  status          String    @default("ACTIVE")
  plannedStart    DateTime? @map("planned_start")
  plannedFinish   DateTime? @map("planned_finish")
  actualStart     DateTime? @map("actual_start")
  actualFinish    DateTime? @map("actual_finish")
  percentComplete Decimal   @default(0) @map("percent_complete") @db.Decimal(5, 2)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  nodes        ProjectNode[]
  dependencies ProjectDependency[]

  @@index([entityId])
  @@index([siteId])
  @@map("projects")
}

/// A node in a project WBS tree. `parentId` is a nullable self-link (no relation, indexed).
model ProjectNode {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId        String?         @map("parent_id") @db.Uuid
  type            ProjectNodeType
  title           String
  ownerUserId     String?         @map("owner_user_id") @db.Uuid
  plannedStart    DateTime?       @map("planned_start")
  plannedFinish   DateTime?       @map("planned_finish")
  actualStart     DateTime?       @map("actual_start")
  actualFinish    DateTime?       @map("actual_finish")
  percentComplete Decimal         @default(0) @map("percent_complete") @db.Decimal(5, 2)
  weight          Decimal         @default(1) @db.Decimal(20, 4)
  position        Int             @default(0)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  notes ProjectNodeNote[]

  @@index([projectId])
  @@index([parentId])
  @@map("project_nodes")
}

/// A dependency between two WBS nodes (predecessor → successor). depType e.g. FS/SS/FF/SF.
model ProjectDependency {
  id                String  @id @default(uuid()) @db.Uuid
  projectId         String  @map("project_id") @db.Uuid
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorNodeId String  @map("predecessor_node_id") @db.Uuid
  successorNodeId   String  @map("successor_node_id") @db.Uuid
  depType           String  @default("FS") @map("dep_type")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_dependencies")
}

/// A note (with optional attachment) against a WBS node.
model ProjectNodeNote {
  id            String      @id @default(uuid()) @db.Uuid
  nodeId        String      @map("node_id") @db.Uuid
  node          ProjectNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  authorId      String?     @map("author_id") @db.Uuid
  body          String
  attachmentKey String?     @map("attachment_key")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([nodeId])
  @@map("project_node_notes")
}

/// A reusable WBS template (JSON structure) for a job type.
model WbsTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  entityId  String? @map("entity_id") @db.Uuid
  name      String
  jobType   String? @map("job_type")
  structure Json

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@map("wbs_templates")
}

// ===========================================================================
// D) STATUTORY RETURNS HUB + WHT — a filing calendar of statutory returns with
// remittances, and withholding-tax transactions/effective-dated rates.
// Not site-scoped (RLS off; GRANT only).
// ===========================================================================

/// Direction of a withholding-tax transaction: SUFFERED (we bore it) vs PAYABLE (we owe it).
enum WhtDirection {
  SUFFERED
  PAYABLE
}

/// A statutory return (filing) for an entity, tax type and period.
model StatutoryReturn {
  id             String    @id @default(uuid()) @db.Uuid
  entityId       String?   @map("entity_id") @db.Uuid
  taxType        String    @map("tax_type")
  periodMonth    String    @map("period_month")
  currency       String
  amountDue      Decimal   @default(0) @map("amount_due") @db.Decimal(20, 2)
  amountPaid     Decimal   @default(0) @map("amount_paid") @db.Decimal(20, 2)
  filingDeadline DateTime? @map("filing_deadline")
  status         String    @default("DUE")
  source         String?
  sourceRef      String?   @map("source_ref")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  remittances ReturnRemittance[]

  @@index([entityId])
  @@index([periodMonth])
  @@index([taxType, periodMonth])
  @@map("statutory_returns")
}

/// A remittance (payment) against a statutory return.
model ReturnRemittance {
  id                 String          @id @default(uuid()) @db.Uuid
  returnId           String          @map("return_id") @db.Uuid
  return             StatutoryReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  paidAt             DateTime        @map("paid_at")
  amount             Decimal         @db.Decimal(20, 2)
  currency           String
  reference          String?
  proofAttachmentKey String?         @map("proof_attachment_key")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([returnId])
  @@map("return_remittances")
}

/// A withholding-tax transaction (suffered or payable).
model WhtTransaction {
  id                  String       @id @default(uuid()) @db.Uuid
  entityId            String?      @map("entity_id") @db.Uuid
  direction           WhtDirection
  counterparty        String?
  relatedPaymentRef   String?      @map("related_payment_ref")
  taxBase             Decimal      @default(0) @map("tax_base") @db.Decimal(20, 2)
  rate                Decimal      @default(0) @db.Decimal(20, 6)
  amount              Decimal      @default(0) @db.Decimal(20, 2)
  currency            String
  certificateRef      String?      @map("certificate_ref")
  certificateReceived Boolean      @default(false) @map("certificate_received")
  taxPeriod           String?      @map("tax_period")
  status              String       @default("OPEN")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@map("wht_transactions")
}

/// An effective-dated withholding-tax rate for a country + category.
model WhtRate {
  id              String   @id @default(uuid()) @db.Uuid
  country         String   @default("ZW")
  category        String
  rate            Decimal  @db.Decimal(20, 6)
  thresholdAmount Decimal? @map("threshold_amount") @db.Decimal(20, 2)
  effectiveFrom   DateTime @map("effective_from")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country, category, effectiveFrom])
  @@map("wht_rates")
}

// ===========================================================================
// E) BACK-PAY + ACTING ALLOWANCES — back-pay batches/lines from gazetted rate
// changes, acting assignments, and extra earnings fed into payroll runs.
// Not site-scoped (RLS off; GRANT only).
// ===========================================================================

/// A basis for an acting allowance: FIXED amount vs PERCENT of salary.
enum ActingBasis {
  FIXED
  PERCENT
}

/// A batch of back-pay arising from a gazetted rate change effective from a date.
model BackPayBatch {
  id                String    @id @default(uuid()) @db.Uuid
  entityId          String?   @map("entity_id") @db.Uuid
  name              String
  rateEffectiveFrom DateTime  @map("rate_effective_from")
  gazettedAt        DateTime? @map("gazetted_at")
  currency          String    @default("USD")
  status            String    @default("DRAFT")
  approvalRef       String?   @map("approval_ref")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  lines BackPayLine[]

  @@index([entityId])
  @@map("back_pay_batches")
}

/// One employee-period back-pay line within a batch (old vs new, difference).
model BackPayLine {
  id          String       @id @default(uuid()) @db.Uuid
  batchId     String       @map("batch_id") @db.Uuid
  batch       BackPayBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employeeId  String       @map("employee_id") @db.Uuid
  periodMonth String       @map("period_month")
  oldAmount   Decimal      @default(0) @map("old_amount") @db.Decimal(20, 2)
  newAmount   Decimal      @default(0) @map("new_amount") @db.Decimal(20, 2)
  difference  Decimal      @default(0) @db.Decimal(20, 2)
  taxable     Boolean      @default(true)
  pensionable Boolean      @default(false)
  nssaAble    Boolean      @default(false) @map("nssa_able")
  workings    Json?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([batchId])
  @@index([employeeId])
  @@map("back_pay_lines")
}

/// An acting assignment (employee acting in a higher position) with an allowance basis.
model ActingAssignment {
  id                String      @id @default(uuid()) @db.Uuid
  entityId          String?     @map("entity_id") @db.Uuid
  employeeId        String      @map("employee_id") @db.Uuid
  actingPosition    String      @map("acting_position")
  actingGrade       String?     @map("acting_grade")
  dateFrom          DateTime    @map("date_from")
  dateTo            DateTime    @map("date_to")
  basis             ActingBasis
  fixedAmount       Decimal?    @map("fixed_amount") @db.Decimal(20, 2)
  currency          String?
  percent           Decimal?    @db.Decimal(5, 2)
  minQualifyingDays Int?        @map("min_qualifying_days")
  status            String      @default("DRAFT")
  approvalRef       String?     @map("approval_ref")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@index([employeeId])
  @@map("acting_assignments")
}

/// An extra earning (back-pay / acting allowance) fed into a payroll run for an employee.
model PayrollExtraEarning {
  id          String  @id @default(uuid()) @db.Uuid
  entityId    String? @map("entity_id") @db.Uuid
  runId       String? @map("run_id") @db.Uuid
  employeeId  String  @map("employee_id") @db.Uuid
  kind        String
  label       String
  amount      Decimal @default(0) @db.Decimal(20, 2)
  currency    String  @default("USD")
  periodMonth String? @map("period_month")
  taxable     Boolean @default(true)
  pensionable Boolean @default(false)
  nssaAble    Boolean @default(false) @map("nssa_able")
  sourceTable String? @map("source_table")
  sourceId    String? @map("source_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@index([runId])
  @@index([employeeId])
  @@map("payroll_extra_earnings")
}

// ===========================================================================
// F) LONG-CONTRACT MONTHLY SITE REPORTS + PERFORMANCE/RAG — periodic site
// reports with sections, KPIs (targets/actuals/RAG), PPE and stores withdrawals.
// `site_report_periods` and `stores_withdrawals` are SITE-SCOPED (site_id → RLS on).
// ===========================================================================

/// RAG (Red/Amber/Green) performance status for a KPI actual.
enum RagStatus {
  GREEN
  AMBER
  RED
}

/// A monthly site report period (site-scoped). One per (site, month).
model SiteReportPeriod {
  id                String    @id @default(uuid()) @db.Uuid
  entityId          String?   @map("entity_id") @db.Uuid
  siteId            String    @map("site_id") @db.Uuid
  contractId        String?   @map("contract_id") @db.Uuid
  periodMonth       String    @map("period_month")
  status            String    @default("OPEN")
  deadline          DateTime?
  submittedAt       DateTime? @map("submitted_at")
  submittedByUserId String?   @map("submitted_by_user_id") @db.Uuid
  narrative         String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  sections SiteReportSection[]

  @@unique([siteId, periodMonth])
  @@index([entityId])
  @@index([siteId])
  @@map("site_report_periods")
}

/// A section within a site report period (ADMIN/OPERATIONS/FINANCE/PPE/…).
model SiteReportSection {
  id            String           @id @default(uuid()) @db.Uuid
  reportId      String           @map("report_id") @db.Uuid
  report        SiteReportPeriod @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sectionKey    String           @map("section_key")
  title         String
  ownerUserId   String?          @map("owner_user_id") @db.Uuid
  content       Json?
  autoPopulated Boolean          @default(false) @map("auto_populated")
  completedAt   DateTime?        @map("completed_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([reportId])
  @@map("site_report_sections")
}

/// A KPI definition (optionally scoped to a contract/site).
model SiteKpi {
  id         String  @id @default(uuid()) @db.Uuid
  entityId   String? @map("entity_id") @db.Uuid
  contractId String? @map("contract_id") @db.Uuid
  siteId     String? @map("site_id") @db.Uuid
  kpiKey     String  @map("kpi_key")
  name       String
  unit       String?
  weight     Decimal @default(1) @db.Decimal(20, 4)
  direction  String  @default("HIGHER_BETTER")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  targets SiteKpiTarget[]
  actuals SiteKpiActual[]

  @@index([entityId])
  @@index([contractId])
  @@index([siteId])
  @@map("site_kpis")
}

/// An effective-dated / per-period target for a KPI.
model SiteKpiTarget {
  id            String    @id @default(uuid()) @db.Uuid
  kpiId         String    @map("kpi_id") @db.Uuid
  kpi           SiteKpi   @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  periodMonth   String?   @map("period_month")
  effectiveFrom DateTime? @map("effective_from")
  targetValue   Decimal   @map("target_value") @db.Decimal(20, 4)
  tolerance     Decimal?  @db.Decimal(20, 4)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kpiId])
  @@map("site_kpi_targets")
}

/// A per-period actual value for a KPI, with a computed RAG status.
model SiteKpiActual {
  id          String    @id @default(uuid()) @db.Uuid
  kpiId       String    @map("kpi_id") @db.Uuid
  kpi         SiteKpi   @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  periodMonth String    @map("period_month")
  actualValue Decimal   @default(0) @map("actual_value") @db.Decimal(20, 4)
  rag         RagStatus @default(GREEN)
  computedAt  DateTime  @default(now()) @map("computed_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kpiId])
  @@map("site_kpi_actuals")
}

/// A PPE requirement definition (by role and/or employee).
model PpeRequirement {
  id             String  @id @default(uuid()) @db.Uuid
  entityId       String? @map("entity_id") @db.Uuid
  role           String?
  employeeId     String? @map("employee_id") @db.Uuid
  itemType       String  @map("item_type")
  quantity       Int     @default(1)
  lifespanMonths Int?    @map("lifespan_months")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@index([employeeId])
  @@map("ppe_requirements")
}

/// A PPE issue event to an employee.
model PpeIssue {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  itemType       String    @map("item_type")
  issueDate      DateTime  @map("issue_date")
  size           String?
  replacementDue DateTime? @map("replacement_due")
  condition      String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("ppe_issues")
}

/// A stores withdrawal (site-scoped): fuel/oil/material/tool drawn at a site.
model StoresWithdrawal {
  id          String   @id @default(uuid()) @db.Uuid
  entityId    String?  @map("entity_id") @db.Uuid
  siteId      String   @map("site_id") @db.Uuid
  itemType    String   @map("item_type")
  description String?
  quantity    Decimal  @default(0) @db.Decimal(20, 4)
  unit        String?
  value       Decimal  @default(0) @db.Decimal(20, 2)
  currency    String   @default("USD")
  vehicleRef  String?  @map("vehicle_ref")
  drawnAt     DateTime @map("drawn_at")
  allocation  Decimal? @db.Decimal(20, 4)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityId])
  @@index([siteId])
  @@map("stores_withdrawals")
}

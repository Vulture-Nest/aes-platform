// AES platform — Prisma schema.
//
// S1 Foundations: local JWT auth (self-managed, NOT Entra/OIDC),
// self-managed RBAC (roles per user per site), append-only audit log, and sites.
// Financial-core tables (orders, ledger, tax, …) arrive in S3.
//
// Conventions (see the README "Architecture decisions"):
//   - UUID primary keys
//   - created_by / created_at / updated_by / updated_at on business tables
//   - money stored as (amount, currency, fx_rate_id, rate_type) — never a bare number

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trivial table used only to prove connectivity + migrations in the S0 scaffold.
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_check")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// Roles per spec §4. Enforced by our own guards (self-managed RBAC).
enum Role {
  SITE_CLERK
  SITE_MANAGER
  OPS_STAFF
  FINANCE_OFFICER
  FINANCE_DIRECTOR // FD
  OPS_DIRECTOR // OD
  DIRECTOR // Managing Director / Directors
  SYS_ADMIN
  AUDITOR // read-only
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

enum SiteType {
  MINE_SITE
  HEAD_OFFICE
}

// ---------------------------------------------------------------------------
// Identity — local user store (we own auth; no third-party IdP)
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  /// Optional link to an employees record (added in S8 HR-lite).
  employeeId   String?    @map("employee_id") @db.Uuid
  /// Privileged roles (FD/OD/Director/SysAdmin) must complete MFA — enforced later.
  mfaRequired  Boolean    @default(false) @map("mfa_required")
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime?  @map("last_login_at")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  siteRoles     UserSiteRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Hashed refresh tokens for rotation + server-side revocation. Access tokens are
/// stateless JWTs; refresh tokens are opaque and revocable here.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Set when this token is rotated, pointing at its successor (reuse detection).
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// RBAC assignment: a role for a user, optionally scoped to one site.
/// site_id NULL = the role applies across all sites (e.g. SYS_ADMIN, AUDITOR).
model UserSiteRole {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String? @map("site_id") @db.Uuid
  site   Site?   @relation(fields: [siteId], references: [id])
  role   Role

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, siteId, role])
  @@index([userId])
  @@map("user_site_roles")
}

// ---------------------------------------------------------------------------
// Reference data (minimal here; rates/thresholds/delegation land in the next S1 PR)
// ---------------------------------------------------------------------------

model Site {
  id       String   @id @default(uuid()) @db.Uuid
  name     String   @unique
  type     SiteType
  /// Set when a site maps to a client (mine sites); null for head office.
  clientId String?  @map("client_id") @db.Uuid
  active   Boolean  @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles UserSiteRole[]

  @@map("sites")
}

// ---------------------------------------------------------------------------
// Audit — append-only (no UPDATE/DELETE grants; enforced in the SQL migration)
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  actorUserId   String?     @map("actor_user_id") @db.Uuid
  action        AuditAction
  tableName     String      @map("table_name")
  recordId      String?     @map("record_id")
  before        Json?
  after         Json?
  correlationId String?     @map("correlation_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tableName, recordId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Reference data — all effective-dated, append-only where noted (spec S1)
// ---------------------------------------------------------------------------

enum Currency {
  USD
  ZWG
}

/// Append-only, effective-dated FX rates (official + parallel/street). Never overwritten;
/// a newer effective date supersedes. `rateAsOf(date, type)` reads the latest ≤ date.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  dateEffective DateTime @map("date_effective")
  currencyPair  String   @map("currency_pair") // e.g. "USD/ZWG"
  officialRate  Decimal  @map("official_rate") @db.Decimal(20, 6)
  parallelRate  Decimal? @map("parallel_rate") @db.Decimal(20, 6)
  source        String?
  enteredBy     String?  @map("entered_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([currencyPair, dateEffective])
  @@map("exchange_rates")
}

/// Effective-dated statutory parameters (VAT %, ZIMRA interest %, NSSA/ZIMDEF/NEC/MIPF,
/// PAYE bands per currency as JSON). Config, never hardcoded.
model StatutoryRate {
  id            String    @id @default(uuid()) @db.Uuid
  key           String // vat_pct, zimra_interest_pct, nssa_*, zimdef_pct, paye_bands, aids_levy_pct
  currency      Currency?
  value         Decimal?  @db.Decimal(20, 6)
  params        Json?
  dateEffective DateTime  @map("date_effective")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([key, currency, dateEffective])
  @@map("statutory_rates")
}

/// Effective-dated thresholds + tunable parameters (petty-cash FD threshold per currency,
/// SLA timers, danger-rule params).
model Threshold {
  id            String    @id @default(uuid()) @db.Uuid
  key           String // petty_cash_fd_threshold, sla_reminder_hours, danger_cash_runway_weeks
  currency      Currency?
  value         Decimal?  @db.Decimal(20, 6)
  params        Json?
  dateEffective DateTime  @default(now()) @map("date_effective")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([key, currency, dateEffective])
  @@map("thresholds")
}

/// Approver → alternate substitution for a date range (used by the approval engine).
model DelegationRule {
  id             String   @id @default(uuid()) @db.Uuid
  approverUserId String   @map("approver_user_id") @db.Uuid
  delegateUserId String   @map("delegate_user_id") @db.Uuid
  dateFrom       DateTime @map("date_from")
  dateTo         DateTime @map("date_to")
  active         Boolean  @default(true)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([approverUserId, active])
  @@map("delegation_rules")
}

// ---------------------------------------------------------------------------
// Notifications (spec S1) — channel abstraction with per-user preferences
// ---------------------------------------------------------------------------

enum NotificationSeverity {
  INFO
  WATCH
  DANGER
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  TEAMS
}

model Notification {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  template     String
  payload      Json?
  severity     NotificationSeverity @default(INFO)
  subjectTable String?              @map("subject_table")
  subjectId    String?              @map("subject_id")
  readAt       DateTime?            @map("read_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  channel NotificationChannel
  enabled Boolean             @default(true)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

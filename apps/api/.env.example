# AES API environment. Copy to apps/api/.env for local dev.
# Validated at boot by src/config/env.validation.ts — the app refuses to start if invalid.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_TIMEZONE=Africa/Harare

# PostgreSQL 16 (matches docker-compose.dev.yml defaults)
DATABASE_URL=postgresql://aes:aes_local_dev@localhost:5432/aes?schema=public

# Redis 7 / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO — local stand-in for SharePoint/Graph storage (StorageService)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=aes-minio
STORAGE_SECRET_KEY=aes_minio_local_dev
STORAGE_BUCKET=aes-files

# --- Placeholders for later stages (S1+); not required for the S0 scaffold ---
# Microsoft Entra ID (OIDC)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
